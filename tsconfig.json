{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ES2020", "WebWorker"],
    "types": ["vscode", "w3c-web-serial", "w3c-web-usb"]
  },
  "include": ["src/**/*.ts"],
  // src/node and src/webview are their own projects (node types, the DOM); nothing
  // here imports either, so excluding them as roots keeps them out entirely.
  "exclude": ["node_modules", "dist", "src/node", "src/webview"]
}
