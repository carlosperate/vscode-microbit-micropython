{
	// A document, not a worker: it needs the DOM the root project deliberately
	// keeps out of `lib`, and neither `vscode` nor node's types, which it has
	// neither of at runtime.
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"lib": ["ES2020", "DOM"],
		"types": []
	},
	// The root project excludes this folder, and `extends` would inherit that.
	"exclude": [],
	"include": ["**/*.ts", "**/*.d.ts"]
}
