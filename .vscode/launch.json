{
	"version": "0.2.0",
	"configurations": [
		{
			// debugWebWorkerHost is what makes the extension host breakpointable, and
			// it needs the host named, which is why this passes the kind that
			// config/desktop.mjs deliberately leaves off.
			"name": "Run Web Extension",
			"type": "extensionHost",
			"debugWebWorkerHost": true,
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--extensionDevelopmentKind=web",
				"${workspaceFolder}/test/workspace"
			],
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			"preLaunchTask": "npm: build"
		}
	]
}
