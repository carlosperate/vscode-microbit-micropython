{
  "name": "microbit-micropython",
  "displayName": "micro:bit MicroPython",
  "description": "Build and flash a MicroPython project to a BBC micro:bit over WebUSB, with a serial REPL.",
  "version": "0.1.0",
  "publisher": "carlosperate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/carlosperate/vscode-microbit-micropython.git"
  },
  "bugs": {
    "url": "https://github.com/carlosperate/vscode-microbit-micropython/issues"
  },
  "homepage": "https://github.com/carlosperate/vscode-microbit-micropython#readme",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "microbit",
    "micropython",
    "python",
    "webusb",
    "embedded",
    "repl"
  ],
  "activationEvents": [],
  "browser": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "microbit-micropython.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "scripts": {
    "build": "node config/esbuild.config.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run --config config/vitest.config.mts",
    "test:watch": "vitest --config config/vitest.config.mts",
    "serve": "npm run build && vscode-test-web --browser=none --port=3000 --extensionDevelopmentPath=. ./test/workspace",
    "chrome": "npm run build && vscode-test-web --browser=chromium --extensionDevelopmentPath=. ./test/workspace",
    "desktop": "npm run build && node config/desktop.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/test-web": "^0.0.81",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
